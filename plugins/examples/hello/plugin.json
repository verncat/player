{
  "id": "example.hello",
  "name": "Hello Player",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "A small installable example with settings and playback events.",
  "platforms": [
    "macos",
    "windows",
    "linux",
    "android"
  ],
  "permissions": [
    "ui",
    "settings",
    "playback.read"
  ],
  "contributions": [
    {
      "id": "home",
      "kind": "page",
      "label": "Hello Player"
    },
    {
      "id": "preferences",
      "kind": "settings",
      "label": "Hello Player"
    },
    {
      "id": "status",
      "kind": "player-widget",
      "label": "Hello Player",
      "slot": "player.status"
    }
  ],
  "author": {
    "name": "Example author",
    "url": "https://example.com"
  },
  "repository": "https://github.com/example/my-plugin",
  "homepage": "https://github.com/example/my-plugin",
  "image": "data:image/png;base64,"
}
